{
  "name": "runshi",
  "version": "1.5.0",
  "description": "润石 PoliShit - 润色构石，构石虽糙，一润成文",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "test": "node --test",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.runshi.app",
    "productName": "润石 PoliShit",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "artifactName": "润石 PoliShit-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "icon": "assets/icon-1024.png"
    },
    "win": {
      "artifactName": "润石 PoliShit Setup ${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon-256.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "润石 PoliShit"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "scripts/selection_probe.swift",
      "assets/**/*"
    ]
  }
}
