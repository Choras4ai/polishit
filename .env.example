RUNSHI_SERVER_HOST=127.0.0.1
RUNSHI_SERVER_PORT=8787
# CI / 隔离回归时可设为 0，禁用自动读取仓库根目录 .env
# RUNSHI_LOAD_DOTENV=0
RUNSHI_ADMIN_PASSWORD=
RUNSHI_SERVER_DB=./data/commercial.sqlite3
RUNSHI_PUBLIC_BASE_URL=http://127.0.0.1:8787
RUNSHI_PAYMENT_MODE=manual

# mock / aliyun / tencent 等，当前第一阶段仅内置 mock
RUNSHI_SMS_PROVIDER=mock
# 生产环境请留空；仅本地调试时再填写固定验证码
RUNSHI_TEST_CODE=
RUNSHI_INITIAL_CREDITS=5
RUNSHI_TRIAL_FREE_USES=10

# 积分包方案：默认 9.9 / 300 积分
RUNSHI_MEMBERSHIP_PLAN_ID=runshi-basic
RUNSHI_MEMBERSHIP_PLAN_NAME=基础积分包
RUNSHI_MEMBERSHIP_PRICE_CENTS=990
RUNSHI_CREDITS_PER_PACK=300

# 硅基流动 API（核心上游）
RUNSHI_SILICONFLOW_API_KEY=
RUNSHI_SILICONFLOW_API_URL=https://api.siliconflow.cn/v1

# 设备绑定（免登录）
RUNSHI_DEVICE_TOKEN_TTL_DAYS=365

# 限流配置
RUNSHI_RATE_DEVICE_PER_MIN=20
RUNSHI_RATE_DEVICE_PER_DAY=500
RUNSHI_RATE_GLOBAL_QPS=400

# 熔断器配置
RUNSHI_CB_FAILURE_THRESHOLD=0.1
RUNSHI_CB_LATENCY_THRESHOLD=5000
RUNSHI_CB_OPEN_DURATION_MS=60000

# 成本控制（元）
RUNSHI_COST_DAILY_LIMIT=500
RUNSHI_COST_MONTHLY_LIMIT=10000
RUNSHI_COST_DEGRADE_PERCENT=80

# 请求队列
RUNSHI_QUEUE_MAX_CONCURRENT=50
RUNSHI_QUEUE_MAX_QUEUED=200
RUNSHI_QUEUE_TIMEOUT_MS=30000

# 降级模型（免费模型）
RUNSHI_DEGRADED_MODEL=Qwen/Qwen3-8B

# 生产环境建议显式配置服务端上游，不要依赖内置预设
RUNSHI_UPSTREAM_PROVIDER=openai
RUNSHI_UPSTREAM_API_URL=
RUNSHI_UPSTREAM_API_KEY=
RUNSHI_UPSTREAM_MODEL=

# 支付通道预留：例如 aifaka,hupijiao,wechatpay,alipay
RUNSHI_PAYMENT_PROVIDERS=

# 微信支付回调配置
RUNSHI_WECHATPAY_APP_ID=
RUNSHI_WECHATPAY_MCH_ID=
RUNSHI_WECHATPAY_SERIAL_NO=
RUNSHI_WECHATPAY_PRIVATE_KEY_PATH=
RUNSHI_WECHATPAY_PLATFORM_PUBLIC_KEY_PATH=
RUNSHI_WECHATPAY_API_V3_KEY=
RUNSHI_WECHATPAY_NOTIFY_PATH=/api/pay/callback/wechat

# 支付宝回调配置
RUNSHI_ALIPAY_APP_ID=
RUNSHI_ALIPAY_PRIVATE_KEY_PATH=
RUNSHI_ALIPAY_PUBLIC_KEY_PATH=
RUNSHI_ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
RUNSHI_ALIPAY_NOTIFY_PATH=/api/pay/callback/alipay
RUNSHI_ALIPAY_RETURN_PATH=/pay/alipay/return
