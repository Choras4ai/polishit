# ============================================================
# 润石 PoliShit 后端配置模板
# 复制为 .env 后填写真实值。.env 严禁提交到 git。
# ============================================================

# ── 服务器基础 ──
# 生产部署必须设置；生产模式拒绝 mock 手机验证码与手动支付。
NODE_ENV=production
RUNSHI_SERVER_HOST=127.0.0.1
RUNSHI_SERVER_PORT=8787
# 仅信任本机反向代理；远程代理需填写其明确 IP/CIDR。
RUNSHI_TRUST_PROXY=loopback
# 生产环境必须是公网 HTTPS 域名（微信回调硬性要求）
RUNSHI_PUBLIC_BASE_URL=https://www.runshi.top
RUNSHI_SERVER_DB=/opt/runshi/data/commercial.sqlite3
RUNSHI_ADMIN_USERNAME=runshi_admin
# 生产环境只保存 scrypt 单向哈希，不保存明文管理员密码。
RUNSHI_ADMIN_PASSWORD_HASH=
# 仅供旧版/本地兼容；生产环境保持为空。
RUNSHI_ADMIN_PASSWORD=

# ── 支付总开关 ──
# manual = 手动开单（测试）；online = 真实在线支付
RUNSHI_PAYMENT_MODE=online
RUNSHI_PAYMENT_PROVIDERS=wechatpay

# ============================================================
# 微信支付 V3（Native 扫码支付）
# 全部信息来自 商户平台 pay.weixin.qq.com
# ============================================================

# 1️⃣ AppID：与商户号完成绑定的公众号/小程序/APP 的 AppID
#    位置：商户平台 → 产品中心 → AppID 账号管理
#    格式：wx 开头 18 位
RUNSHI_WECHATPAY_APP_ID=wx????????????????

# 2️⃣ 商户号（mchid）：商户平台首页右上角，8-12 位纯数字
RUNSHI_WECHATPAY_MCH_ID=

# 3️⃣ 商户 API 证书序列号
#    位置：账户中心 → API安全 → API证书 → 查看证书序列号
#    格式：40 位十六进制大写
RUNSHI_WECHATPAY_SERIAL_NO=

# 4️⃣ 商户 API 私钥（apiclient_key.pem 的文件路径，推荐用路径而非内联）
#    ⚠️ 是 apiclient_key.pem（私钥），不是 apiclient_cert.pem（证书）
RUNSHI_WECHATPAY_PRIVATE_KEY_PATH=/opt/runshi/keys/apiclient_key.pem

# 5️⃣ 微信支付公钥（新商户模式）
#    位置：账户中心 → API安全 → 微信支付公钥 → 下载 pub_key.pem
RUNSHI_WECHATPAY_PLATFORM_PUBLIC_KEY_PATH=/opt/runshi/keys/wechatpay_pub_key.pem

# 6️⃣ 微信支付公钥 ID（与上面公钥配套）
#    位置：同上页面，形如 PUB_KEY_ID_0000000000000024101100397200000006
RUNSHI_WECHATPAY_PUBLIC_KEY_ID=PUB_KEY_ID_

# 7️⃣ APIv3 密钥：自己设置的恰好 32 位字符串
#    位置：账户中心 → API安全 → APIv3密钥 → 设置
RUNSHI_WECHATPAY_API_V3_KEY=

# 回调路径（一般不用改，完整回调 = PUBLIC_BASE_URL + 此路径）
RUNSHI_WECHATPAY_NOTIFY_PATH=/api/pay/callback/wechat

# ============================================================
# 上游 AI 模型（托管积分模式）
# ============================================================
RUNSHI_SILICONFLOW_API_KEY=

# ── 其他 ──
# 尚未接入真实短信发送服务；生产环境使用邮箱与密码登录。
RUNSHI_SMS_PROVIDER=disabled
RUNSHI_INITIAL_CREDITS=5
